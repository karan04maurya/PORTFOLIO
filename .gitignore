dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/

# ----- Environment & Secrets --------------------------------
.env
.env.local
.env.*.local

# ----- Logs -------------------------------------------------
logs/
*.log

# ----- Misc -------------------------------------------------
*.bak
*.tmp
*.zip
*.tar.gz
